{
	"name": "perfect-finances",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "bun --bun vite dev",
		"build": "bun --bun vite build",
		"start": "bun ./build",
		"prod": "bun ./build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "bun src/lib/server/db/migrate.ts",
		"db:seed": "bun src/db/seed.ts",
		"db:setup": "bun db:generate && bun db:migrate && bun db:seed",
		"db:clean": "drizzle-kit drop && rm -f db/sqlite.db",
		"docker:build": "docker build --pull --platform linux/amd64 -t ghcr.io/samwarnick/perfect-finances .",
		"docker:push": "docker push ghcr.io/samwarnick/perfect-finances:latest",
		"docker:publish": "bun docker:build && bun docker:push"
	},
	"dependencies": {
		"drizzle-orm": "^0.45.4",
		"luxon": "^3.7.2",
		"open-props": "^1.7.23",
		"zod": "^3.24.2"
	},
	"devDependencies": {
		"@sveltejs/adapter-bun": "^1.0.0",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/bun": "^1.4.4",
		"@types/luxon": "^3.7.6",
		"drizzle-kit": "^0.31.11",
		"prettier": "^3.9.10",
		"svelte": "^5.57.3",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.5"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
